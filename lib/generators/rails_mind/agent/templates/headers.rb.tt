#!/usr/bin/env ruby
# Authentication helper for RailsMind. Use --check for a secret-free readiness check.
ENV["BUNDLE_GEMFILE"] = File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "rails_mind/agent_headers"
exit RailsMind::AgentHeaders.run(ARGV, root: File.expand_path("..", __dir__))
