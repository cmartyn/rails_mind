RailsMind.configure do |config|
  # Enabled by default: reduce routine successful request events using hosted policy.
  # Local opt-out does not disable server sampling or the environment daily quota.
  # config.automatic_sampling = false
  config.token = ENV["RAILS_MIND_KEY"] # Environment-scoped server credential. Never expose to browsers.

  # Endpoint defaults to https://railsmind.com; RAILS_MIND_ENDPOINT overrides it.
  # Release is detected from hosting metadata or Rails.root/REVISION when available.
  # RAILS_MIND_RELEASE is an optional override. Neither variable is required.

  # Optional capabilities can be switched off independently.
  # config.apm = false
  # config.errors = false
  # config.analytics = false
  # config.flags = false

  # Exception messages are scrubbed (emails, credentials) and sent. Set false to replace
  # them with a placeholder and keep them in your app.
  # config.capture_exception_message = false
  # Repeated queries are sent as a fingerprint plus their shape (the normalized SQL with
  # literals replaced and comments removed). Set false to send the fingerprints only.
  # config.capture_query_shapes = false
  # config.before_send = ->(event) { event } # Return nil to drop an event.

  # Page views: each HTML page a controller renders for a person (not a bot, prefetch,
  # Turbo Frame or health check) is counted, with a first-party visitor cookie.
  # config.page_views = false # Count no page views.
  # config.visitor_cookie = false # Count visitors by a daily hash instead of a cookie.
  # config.link_page_views_to_users = false # Keep user and account IDs off page views.
  # config.ignore_page_view = ->(request) { request.path.start_with?("/admin") }
end

# No existing Ahoy store, Flipper adapter, or OpenTelemetry provider is changed.
# Run `bin/rails rails_mind:doctor` and follow docs/sdk.md for opt-in integrations.
